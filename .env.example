# Core
PROJECT_NAME=stock-direction-platform
ENVIRONMENT=local
SYMBOLS=^NSEI
UNIVERSE_TIER=nifty50
HISTORY_YEARS=16
INTERVAL=1d

# Production data providers. The runnable default uses Yahoo Finance as a development/fallback provider.
# For licensed production feeds, implement/enable a provider in src/stockml/data/providers.py.
MARKET_DATA_PROVIDER=yfinance

# Optional GDELT sentiment. Set ENABLE_SENTIMENT=true only when a news/sentiment provider is configured.
ENABLE_SENTIMENT=false
GDELT_MAX_RECORDS=250

# Optional external MLflow tracking server. Leave blank to use local DB-backed ./artifacts/mlflow.db.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=stock-direction
MLFLOW_REGISTERED_MODEL=stock-direction-lightgbm

# Training
TRAIN_START=
VALIDATION_START=
TEST_START=
N_SPLITS=5
EMBARGO_DAYS=5
PURGE_DAYS=5
OPTUNA_TRIALS=25
OPTUNA_TIMEOUT_SECONDS=0
RANDOM_SEED=42
NUM_BOOST_ROUND=1000
EARLY_STOPPING_ROUNDS=100
CHECKPOINT_EVERY_ROUNDS=25
FORCE_RETRAIN=false

# Triple barrier / target
LABEL_METHOD=triple_barrier
TRIPLE_BARRIER_HORIZON=5
TRIPLE_BARRIER_VOL_WINDOW=20
TRIPLE_BARRIER_UP_MULT=1.0
TRIPLE_BARRIER_DOWN_MULT=1.0
TRIPLE_BARRIER_FLAT_BAND=0.25

# Backtest costs (basis points). Delivery round trip ≈ 31.5 bps (realistic §6.3 band).
BACKTEST_SEGMENT=delivery
COMMISSION_BPS=1.0
SLIPPAGE_BPS=3.0
OTHER_COST_BPS=1.0
CONFIDENCE_THRESHOLD=0.55
MAX_GROSS_EXPOSURE=1.0

# Monitoring
DRIFT_LOOKBACK=20
PSI_BUCKETS=10
DRIFT_PSI_THRESHOLD=0.25

# API
API_HOST=127.0.0.1
API_PORT=8000

# Multimodal news/text
ENABLE_NEWS=true
ENABLE_SENTIMENT=true
NEWS_PROVIDER=alphavantage,gdelt
NEWS_GDELT_DAYS=90
ALPHAVANTAGE_API_KEY=
FINBERT_MODEL=ProsusAI/finbert
FINBERT_DEVICE=-1
FINBERT_CACHE_DIR=./artifacts/hf_cache

# Training safety
OPTUNA_PRUNER=none
CLASS_WEIGHTING=true
CHECKPOINT_EVERY_ROUNDS=1
