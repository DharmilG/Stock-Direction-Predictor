# Secrets — never commit. API keys live ONLY in .env (git-ignored).
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/

# Large rebuildable binaries (data refetch/rebuild via pipeline; see docs/PROJECT_SETUP.md)
*.parquet
*.png
mlruns/
artifacts/hf_cache/

# v2 workspace: a duplicated dataset plus derived boosters and reports, all rebuilt by
# `python -m stockml.v2.train`. Never commit it.
v2/
artifacts/mlflow/
artifacts/*.db

# Kept deliberately: logs/, checkpoints/ (optuna.db + booster checkpoints),
# results/*.json + *.csv (metrics, ledgers, reports), configs, docs, code.

# Local agent/IDE state and pasted chat transcripts — never part of the build.
.qoder/
.lyzo/
session-*.md

# Track Q runtime state lives under track_q/ and IS committed so any machine
# can resume a phase from the last checkpoint (git is the sync layer). Phase
# runtime files (ledgers, verdicts, heartbeats, logs, traces, checkpoints) are
# deliberately tracked. The broad *.parquet ignore above is reverted inside
# track_q/ so the Q0 and phase-3 ledgers/pools are synced too.
!track_q/**/*.parquet
