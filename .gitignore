# Secrets — never commit. API keys live ONLY in .env (git-ignored).
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/

# Large rebuildable binaries (data refetch/rebuild via pipeline; see docs/PROJECT_SETUP.md)
*.parquet
*.png
mlruns/
artifacts/hf_cache/

# v2 workspace: a duplicated dataset plus derived boosters and reports, all rebuilt by
# `python -m stockml.v2.train`. Never commit it.
v2/
artifacts/mlflow/
artifacts/*.db

# Kept deliberately: logs/, checkpoints/ (optuna.db + booster checkpoints),
# results/*.json + *.csv (metrics, ledgers, reports), configs, docs, code.

# Local agent/IDE state and pasted chat transcripts — never part of the build.
.qoder/
.lyzo/
session-*.md

# Track Q0 runtime artifacts — regenerated by run_q0_overnight.ps1. Never commit:
# the 2026-11-17 run had 843 harness failures caused by a broken Ollama install,
# so its verdict/traces/heartbeat are invalid and must stay out of git.
/results/q0_d1.json
/results/traces/
/artifacts/state/q0_d1.json
/logs/q0_*.json
/logs/q0_*.log
/logs/q0_*.txt
/logs/q0_*.csv
/logs/gpu_5s.csv
