# Leave blank to use the Vite dev proxy (recommended): requests to /dashboard/*
# and /health are forwarded to http://127.0.0.1:8000 by vite.config.js.
#
# Set an absolute origin only when the dashboard is served from a different host
# than the API; the API then needs that origin in DASHBOARD_ALLOWED_ORIGINS.
VITE_API_BASE_URL=

# Backend used by the dev/preview proxy (server-side only, never shipped).
DASHBOARD_API_URL=http://127.0.0.1:8000
